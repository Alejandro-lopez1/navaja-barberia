# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID del spreadsheet (la parte entre /d/ y /edit en la URL)
GOOGLE_SPREADSHEET_ID=

# Service account: email y private key (con \n escapados o multilínea entre comillas)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternativa: ruta a un JSON de service account
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── App ───────────────────────────────────────────────────────────────────────
# PIN opcional. Si está vacío, la app queda abierta (solo recomendado en local).
APP_PIN=

# Secreto para firmar la cookie del PIN. Usar un valor aleatorio largo.
AUTH_SECRET=cambiar-por-un-secreto-largo

# Nombre que queda registrado en el log de cambios
ADMIN_NAME=Admin

# Moneda mostrada en la UI
CURRENCY=ARS
# Opcionales: para que el navegador use la misma moneda/zona horaria en formatos
# NEXT_PUBLIC_CURRENCY=ARS
# NEXT_PUBLIC_TIMEZONE=America/Argentina/Buenos_Aires

# ── Desarrollo local sin Google Cloud ─────────────────────────────────────────
# true = usa .data/db.json como base de datos local (NO usar en producción)
SHEETS_MOCK=false
# LOCAL_DB_PATH=.data/db.json
